---
interface Props {
  currentPath: string;
  filename: string;
  icon?: string;
}
const { currentPath, filename, icon = 'blue' } = Astro.props;

const baseTabs = [
  { href: '/', label: 'index.astro', icon: 'blue' },
  { href: '/about', label: 'about.mdx', icon: 'yellow' },
  { href: '/contact', label: 'contact.mdx', icon: 'green' },
];

const isExtra = !baseTabs.some((t) => t.href === currentPath);
const tabs = isExtra
  ? [...baseTabs, { href: currentPath, label: filename, icon }]
  : baseTabs;
---

<div class="tabbar" role="tablist" aria-label="Site navigation">
  {tabs.map((tab) => (
    <a
      href={tab.href}
      class={`tab ${currentPath === tab.href ? 'active' : ''}`}
      role="tab"
      aria-selected={currentPath === tab.href}
    >
      <span class={`icon ${tab.icon}`}>◆</span>
      <span class="label">{tab.label}</span>
      {currentPath === tab.href && <span class="dirty" aria-hidden="true"></span>}
    </a>
  ))}
</div>